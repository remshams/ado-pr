{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "pr.ts",
    "cli.ts",
    "command-registry.ts",
    "operation-types.ts",
    "lib.ts",
    "azure.ts",
    "pull-requests.ts",
    "builds.ts",
    "file-anchors.ts",
    "threads.ts",
    "batch.ts"
  ]
}
