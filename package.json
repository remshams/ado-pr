{
	"name": "ado-pr",
	"private": true,
	"description": "A resource-first CLI for managing Azure DevOps pull requests and review comments from Azure Repos checkouts.",
	"type": "module",
	"scripts": {
		"test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"src/**/*.test.mjs\" \"tests/*.test.mjs\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"coverage": "rm -rf coverage && NODE_V8_COVERAGE=coverage node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"src/**/*.test.mjs\" \"tests/*.test.mjs\"",
		"fallow:dead-code": "fallow dead-code --fail-on-issues",
		"fallow:dupes": "fallow dupes --fail-on-issues",
		"fallow:architecture": "fallow architecture --fail-on-issues",
		"fallow:health": "fallow health --coverage coverage --baseline fallow-health-baseline.json --baseline-mode identity",
		"fallow": "pnpm coverage && pnpm fallow:dead-code && pnpm fallow:dupes && pnpm fallow:architecture && pnpm fallow:health",
		"mutation": "fallow mutation --changed-since \"${MUTATION_BASE:-origin/main}\" --min-score 71",
		"mutation:all": "fallow mutation --all",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm fallow"
	},
	"dependencies": {
		"minimist": "1.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/minimist": "^1.2.5",
		"@types/node": "^24.0.0",
		"fallow": "3.34.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.6.0"
	}
}
