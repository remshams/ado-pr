{
	"name": "ado-pr",
	"private": true,
	"description": "A resource-first CLI for managing Azure DevOps pull requests and review comments from Azure Repos checkouts.",
	"type": "module",
	"scripts": {
		"test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"src/**/*.test.mjs\" \"tests/*.test.mjs\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"dependencies": {
		"minimist": "1.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/minimist": "^1.2.5",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.6.0"
	}
}
